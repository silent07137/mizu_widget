<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_image" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@string/widget_image" />
    <TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:padding="12dp" android:text="@string/widget_empty"
        android:textColor="#214E50" android:textSize="14sp" android:background="@drawable/widget_placeholder" />
</FrameLayout>
