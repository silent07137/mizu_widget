<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@drawable/ic_mizu"
        android:roundIcon="@drawable/ic_mizu"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mizu">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ConfigureActivity" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <activity android:name=".ImageViewerActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />
        <receiver android:name=".MizuWidgetProvider" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mizu_widget_info" />
        </receiver>
        <receiver android:name=".PinReceiver" android:exported="false" />
    </application>
</manifest>
